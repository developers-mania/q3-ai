.venv/
# notebook environment
.venv-1/  
__pycache__/
*.pyc
.env

# Generated from sessions/sNN/lab.py by tools/build_notebooks.py.
# WHY not committed: .ipynb is JSON with embedded outputs and execution counts.
# It diffs badly and merges worse, which would wreck the fix-forward rule in
# CONTRIBUTING.md. The .py is the source of truth; the notebook is a build artifact.
notebooks/*
!notebooks/.gitkeep

# Nothing under corpus/ is ignored. The corpus is committed and frozen — see the
# first non-negotiable in CLAUDE.md. Extraction is not deterministic across tools,
# so a participant who converts their own sources indexes different bytes and the
# baseline stops being one reproducible number. MANIFEST.sha256 is the pin that
# makes every score this quarter comparable, so it must survive a clone.

# Facilitator inputs, not the frozen artifact. The .txt in corpus/ is what ships;
# these are the PDFs it was converted from, and they are large.
sources/*
!sources/.gitkeep
docs/guides/*.docx
docs/guides/*.pdf

# Generated by src/ingest.py, Session 02. Build artifacts, like notebooks/.
# WHY not committed: passages.jsonl is derived from corpus/ + the parser, so it is
# reproducible from two things that ARE committed. Committing it would create a
# second copy of the corpus that can silently drift from the first - which is the
# exact Layer 1 failure this session exists to teach.
passages.jsonl
quarantine.jsonl

# Embedding and cross-encoder models, fetched by tools/fetch_models.py (session 04).
# WHY not committed: roughly 90 MB each. Committing both would take a 1.2 MB clone to
# ~180 MB permanently, for every participant and every session, and git stores binary
# blobs badly - each re-commit adds another copy. They are reproducible from one
# command, and once fetched the pipeline is fully offline, which is the property the
# quarter actually promised. A facilitator can copy models/ onto a USB stick for the
# room; see sessions/s04/README.md.
models/
chroma/

